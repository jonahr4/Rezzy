% ResumeGenie — Auto-generated tailored resume
% Template based on Jake Gutierrez
\documentclass[letterpaper,10pt]{article}

\usepackage{latexsym}
\usepackage[empty]{fullpage}
\usepackage{titlesec}
\usepackage{marvosym}
\usepackage[usenames,dvipsnames]{color}
\usepackage{verbatim}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\usepackage[english]{babel}
\usepackage{tabularx}

\pagestyle{fancy}
\fancyhf{}
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% Expanded width to eliminate orphan wraps
\addtolength{\oddsidemargin}{-0.6in}
\addtolength{\evensidemargin}{-0.6in}
\addtolength{\textwidth}{1.2in}
\addtolength{\topmargin}{-.6in}
\addtolength{\textheight}{1.2in}

\urlstyle{same}

\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

% Sections formatting
\titleformat{\section}{
  \vspace{-5pt}\scshape\raggedright\large
}{}{0em}{}[\color{black}\titlerule \vspace{-4pt}]


% Custom commands
\newcommand{\resumeItem}[1]{
  \item\small{
    {#1 \vspace{-2pt}}
  }
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item\small
    \begin{tabular*}{0.98\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & #2 \\
      \textit{#3} & \textit{#4} \\
    \end{tabular*}\vspace{-6pt}
}

\newcommand{\resumeProjectHeading}[3]{
    \item\small
    \begin{tabular*}{0.98\textwidth}{l@{\extracolsep{\fill}}r}
      #1 & #2 \\
      \textit{#3} & \\
    \end{tabular*}\vspace{-6pt}
}

\newcommand{\resumeItemListStart}{\begin{itemize}}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-2pt}}
\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.15in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}

\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}

% ─── DOCUMENT ────────────────────────────────────

\begin{document}

% ─── HEADER ──────────────────────────────────────
\begin{center}
    \textbf{\fontsize{19}{19}\selectfont\scshape (( personal.name | latex ))} \\ \vspace{2pt}
    \small (( personal.phone | latex )) $|$
    \href{mailto:(( personal.email ))}{\underline{(( personal.email | latex ))}} $|$
    \href{https://(( personal.website ))}{\underline{(( personal.website | latex ))}} $|$
    \href{https://(( personal.linkedin ))}{\underline{(( personal.linkedin | latex ))}} $|$
    \href{https://(( personal.github ))}{\underline{(( personal.github | latex ))}}
\end{center}

% ─── EDUCATION ───────────────────────────────────
\vspace{-3mm}
\section{Education}
\vspace{1.0mm}
  \resumeSubHeadingListStart
  (% for edu in education %)
    \vspace{-2pt}\item\small
      \begin{tabular*}{0.98\textwidth}[t]{l@{\extracolsep{\fill}}r}
        \textbf{(( edu.institution | latex ))} $|$ (( edu.location | latex )) & (( edu.end_date )) \\
        \textit{(( edu.degree | latex ))(% if edu.minor %); Minor in (( edu.minor | latex ))(% endif %)} & GPA: (( edu.gpa ))(% if edu.honors %), (( edu.honors | latex ))(% endif %)
      \end{tabular*}\vspace{-6pt}
      (% if edu.relevant_coursework %)
      \begin{itemize}
          \item \textit{Related Coursework:} (( edu.relevant_coursework | join(', ') | latex ))
      \end{itemize}
      (% endif %)
  (% endfor %)
  \resumeSubHeadingListEnd

% ─── TECHNICAL SKILLS ────────────────────────────
\vspace{-3.0mm}
\section{Technical Skills}
\vspace{1.0mm}
 \begin{itemize}[leftmargin=0.15in, label={}]
    \small{\item{
    (% for cat in skill_categories %)
     \textbf{(( cat['label'] ))}{: (( cat['items'] | join(', ') | latex ))} \\
    (% endfor %)
    }}
 \end{itemize}

% ─── EXPERIENCE ──────────────────────────────────
(% if jobs %)
\vspace{-3.0mm}
\section{Experience}
\vspace{1.0mm}
  \resumeSubHeadingListStart
  (% for job in jobs %)
    \resumeSubheading
      {(( job.title | latex ))}{(( job.start_date )) -- (( job.end_date ))}
      {(( job.company | latex ))}{(( job.location | latex ))}
    \resumeItemListStart
    (% for bullet in job.selected_bullets %)
      \resumeItem{(( bullet.text | latex ))}
    (% endfor %)
    \resumeItemListEnd
  (% endfor %)
  \resumeSubHeadingListEnd
(% endif %)

% ─── PROJECTS ────────────────────────────────────
(% if projects %)
\vspace{-3.0mm}
\section{Personal Projects}
\vspace{1.0mm}
  \resumeSubHeadingListStart
  (% for proj in projects %)
    (% set link_parts = [] %)
    (% if proj.links %)
      (% if proj.links.get('repo') %)
        (% set _ = link_parts.append('\\href{' ~ proj.links.repo ~ '}{\\underline{GitHub}}') %)
      (% endif %)
      (% if proj.links.get('web_repo') %)
        (% set _ = link_parts.append('\\href{' ~ proj.links.web_repo ~ '}{\\underline{GitHub}}') %)
      (% endif %)
      (% if proj.links.get('live') %)
        (% set _ = link_parts.append('\\href{' ~ proj.links.live ~ '}{\\underline{Live}}') %)
      (% endif %)
      (% if proj.links.get('app_store') %)
        (% set _ = link_parts.append('\\href{' ~ proj.links.app_store ~ '}{\\underline{App Store}}') %)
      (% endif %)
      (% if proj.links.get('demo') %)
        (% set _ = link_parts.append('\\href{' ~ proj.links.demo ~ '}{\\underline{Demo}}') %)
      (% endif %)
    (% endif %)
    (% set link_str = ' $|$ '.join(link_parts) if link_parts else '' %)
    (% set title_str = '\\textbf{' ~ (proj.title | latex) ~ '}' ~ (' $|$ ' ~ link_str if link_str else '') %)
    \resumeProjectHeading
      {(( title_str ))}
      {(( proj.start_date )) -- (( proj.end_date ))}
      {(( proj.tagline | latex ))}
    \resumeItemListStart
    (% for bullet in proj.selected_bullets %)
      \resumeItem{(( bullet.text | latex ))}
    (% endfor %)
    \resumeItemListEnd
  (% endfor %)
  \resumeSubHeadingListEnd
(% endif %)

\end{document}
