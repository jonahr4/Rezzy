% ResumeGenie — Auto-generated tailored resume
% Template based on Jake Gutierrez
\documentclass[letterpaper,10pt]{article}

\usepackage{latexsym}
\usepackage[empty]{fullpage}
\usepackage{titlesec}
\usepackage{marvosym}
\usepackage[usenames,dvipsnames]{color}
\usepackage{verbatim}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\usepackage[english]{babel}
\usepackage{tabularx}

\pagestyle{fancy}
\fancyhf{}
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% Expanded width to eliminate orphan wraps
\addtolength{\oddsidemargin}{-0.6in}
\addtolength{\evensidemargin}{-0.6in}
\addtolength{\textwidth}{1.2in}
\addtolength{\topmargin}{-.6in}
\addtolength{\textheight}{1.2in}

\urlstyle{same}

% \raggedbottom % disabled so it spreads evenly when sparse
\raggedright
\setlength{\tabcolsep}{0in}

% ─── SPACING TIER (set by pipeline based on retry count) ──────
% Tier 0 = default spacing (first attempt)
% Tier 1 = tighter spacing (after 1 failed attempt)
% Tier 2 = maximum compression (after 2+ failed attempts)
(% set tier = spacing_tier | default(0) %)

% Section titles — single control for the gap above each section.
% (Previously every \section was also preceded by a \vspace{-Xmm} which
% stacked with this one and could pull the title up into the previous
% section's last line, especially on the compression tiers.)
\titleformat{\section}{
  \vspace{(% if tier >= 2 %)-6pt(% elif tier >= 1 %)-5pt(% else %)-4pt(% endif %)}\scshape\raggedright\large
}{}{0em}{}[\color{black}\titlerule \vspace{(% if tier >= 2 %)-5pt(% elif tier >= 1 %)-4pt(% else %)-3pt(% endif %)}]


% Custom commands with tier-aware spacing.
% Lists use explicit fixed spacing (no rubber glue) so gaps stay even and
% predictable; the negative trims only tighten, never enough to overlap text.
\newcommand{\resumeItem}[1]{
  \item\small{
    {#1 \vspace{(% if tier >= 2 %)-2pt(% elif tier >= 1 %)-1pt(% else %)0pt(% endif %)}}
  }
}

\newcommand{\resumeSubheading}[4]{
  \vspace{(% if tier >= 2 %)-2pt(% elif tier >= 1 %)-1pt(% else %)0pt(% endif %)}\item\small
    \begin{tabular*}{0.98\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & #2 \\
      \textit{#3} & \textit{#4} \\
    \end{tabular*}\vspace{(% if tier >= 2 %)-6pt(% elif tier >= 1 %)-5pt(% else %)-3pt(% endif %)}
}

\newcommand{\resumeProjectHeading}[2]{
    \item\small
    \begin{tabular*}{0.98\textwidth}{l@{\extracolsep{\fill}}r}
      #1 & #2 \\
    \end{tabular*}\vspace{(% if tier >= 2 %)-6pt(% elif tier >= 1 %)-5pt(% else %)-3pt(% endif %)}
}

\newcommand{\resumeProjectHeadingWithTagline}[3]{
    \item\small
    \begin{tabular*}{0.98\textwidth}{l@{\extracolsep{\fill}}r}
      #1 & #2 \\
      \textit{#3} & \\
    \end{tabular*}\vspace{(% if tier >= 2 %)-6pt(% elif tier >= 1 %)-5pt(% else %)-3pt(% endif %)}
}

\newcommand{\resumeItemListStart}{\begin{itemize}[itemsep=4pt, parsep=0pt, topsep=5pt, partopsep=0pt]}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{(% if tier >= 2 %)-2pt(% elif tier >= 1 %)-1pt(% else %)0pt(% endif %)}}
\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.15in, label={}, itemsep=6pt, parsep=0pt, topsep=4pt, partopsep=0pt]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}

\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}

% ─── DOCUMENT ────────────────────────────────────

\begin{document}

% ─── HEADER ──────────────────────────────────────
\begin{center}
    \textbf{\Huge \scshape (( personal.name | latex ))} \\ \vspace{1pt}
    \small 
    (% set contact_items = [] %)
    (% if personal.phone %)(% set _ = contact_items.append(personal.phone | latex) %)(% endif %)
    (% if personal.email %)(% set _ = contact_items.append('\\href{mailto:' ~ personal.email ~ '}{\\underline{' ~ (personal.email | latex) ~ '}}') %)(% endif %)
    (% if personal.website %)(% set _ = contact_items.append('\\href{https://' ~ personal.website ~ '}{\\underline{' ~ (personal.website | latex) ~ '}}') %)(% endif %)
    (% if personal.linkedin %)(% set _ = contact_items.append('\\href{https://' ~ personal.linkedin ~ '}{\\underline{' ~ (personal.linkedin | latex) ~ '}}') %)(% endif %)
    (% if personal.github %)(% set _ = contact_items.append('\\href{https://' ~ personal.github ~ '}{\\underline{' ~ (personal.github | latex) ~ '}}') %)(% endif %)
    (( contact_items | join(' $|$ ') ))
\end{center}

% ─── EDUCATION ───────────────────────────────────
\section{Education}
\vspace{(% if tier >= 2 %)0.4mm(% elif tier >= 1 %)0.8mm(% else %)1.2mm(% endif %)}
  \resumeSubHeadingListStart
  (% for edu in education %)
    \vspace{(% if tier >= 2 %)-2pt(% elif tier >= 1 %)-1pt(% else %)0pt(% endif %)}\item\small
      \begin{tabular*}{0.98\textwidth}[t]{l@{\extracolsep{\fill}}r}
        \textbf{(( edu.institution | latex ))} $|$ (( edu.location | latex )) & (( edu.end_date )) \\
        \textit{(( edu.degree | latex ))(% if edu.minor %); Minor in (( edu.minor | latex ))(% endif %)} & GPA: (( edu.gpa ))(% if edu.honors %), (( edu.honors | latex ))(% endif %)
      \end{tabular*}\vspace{(% if tier >= 2 %)-6pt(% elif tier >= 1 %)-5pt(% else %)-3pt(% endif %)}
      (% if edu.relevant_coursework %)
      \begin{itemize}[itemsep=2pt, parsep=0pt, topsep=3pt, partopsep=0pt]
          \item \textit{Related Coursework:} (( edu.relevant_coursework | join(', ') | latex ))
      \end{itemize}
      (% endif %)
  (% endfor %)
  \resumeSubHeadingListEnd

% ─── TECHNICAL SKILLS ────────────────────────────
\section{Technical Skills}
\vspace{(% if tier >= 2 %)0.4mm(% elif tier >= 1 %)0.8mm(% else %)1.2mm(% endif %)}
 \begin{itemize}[leftmargin=0.15in, label={}, itemsep=3pt, parsep=0pt, topsep=4pt, partopsep=0pt]
    \small{\item{
    (% for cat in skill_categories %)
     \textbf{(( cat['label'] ))}{: (( cat['items'] | join(', ') | latex ))} \\
    (% endfor %)
    }}
 \end{itemize}




% ─── EXPERIENCE ──────────────────────────────────
(% if jobs %)
\section{Experience}
\vspace{(% if tier >= 2 %)0.4mm(% elif tier >= 1 %)0.8mm(% else %)1.2mm(% endif %)}
  \resumeSubHeadingListStart
  (% for job in jobs %)
    \resumeSubheading
      {(( job.title | latex ))}{(( job.start_date )) -- (( job.end_date ))}
      {(( job.company | latex ))}{(( job.location | latex ))}
    \resumeItemListStart
    (% for bullet in job.selected_bullets %)
      \resumeItem{(( bullet.text | latex ))}
    (% endfor %)
    \resumeItemListEnd
  (% endfor %)
  \resumeSubHeadingListEnd
(% endif %)

% ─── PROJECTS ────────────────────────────────────
(% if projects %)
\section{Personal Projects}
\vspace{(% if tier >= 2 %)0.4mm(% elif tier >= 1 %)0.8mm(% else %)1.2mm(% endif %)}
  \resumeSubHeadingListStart
  (% for proj in projects %)
    (% set link_parts = [] %)
    (% if proj.links %)
      (% for link_label, link_url in proj.links.items() %)
        (% if link_url %)
          (% set _ = link_parts.append('\\href{' ~ (link_url | replace('%', '\\%') | replace('#', '\\#') | replace('&', '\\&')) ~ '}{\\underline{' ~ (link_label | latex) ~ '}}') %)
        (% endif %)
      (% endfor %)
    (% endif %)
    (% set link_str = ' $|$ '.join(link_parts) if link_parts else '' %)
    (% set title_str = '\\textbf{' ~ (proj.title | latex) ~ '}' ~ (' $|$ ' ~ link_str if link_str else '') %)
    (% if proj.tagline %)
    \resumeProjectHeadingWithTagline
      {(( title_str ))}
      {(( proj.start_date )) -- (( proj.end_date ))}
      {(( proj.tagline | latex ))}
    (% else %)
    \resumeProjectHeading
      {(( title_str ))}
      {(( proj.start_date )) -- (( proj.end_date ))}
    (% endif %)
    \resumeItemListStart
    (% for bullet in proj.selected_bullets %)
      \resumeItem{(( bullet.text | latex ))}
    (% endfor %)
    \resumeItemListEnd
  (% endfor %)
  \resumeSubHeadingListEnd
(% endif %)

\end{document}
