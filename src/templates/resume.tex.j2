% ResumeGenie — Auto-generated tailored resume
\documentclass[letterpaper,10pt]{article}

\usepackage{latexsym}
\usepackage[empty]{fullpage}
\usepackage{titlesec}
\usepackage{marvosym}
\usepackage[usenames,dvipsnames]{color}
\usepackage{verbatim}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\usepackage[english]{babel}
\usepackage{tabularx}

\pagestyle{fancy}
\fancyhf{}
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% Tight margins for 1-page
\addtolength{\oddsidemargin}{-0.5in}
\addtolength{\evensidemargin}{-0.5in}
\addtolength{\textwidth}{1.0in}
\addtolength{\topmargin}{-0.7in}
\addtolength{\textheight}{1.4in}

\urlstyle{same}
\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}
\setlength{\footskip}{4.08003pt}

% Section headings
\titleformat{\section}{
  \vspace{-4pt}\scshape\raggedright\large
}{}{0em}{}[\color{black}\titlerule \vspace{-5pt}]

% ─── Custom commands ────────────────────────────

\newcommand{\resumeItem}[1]{
  \item\small{#1 \vspace{-2pt}}
}

% CRITICAL: -5pt not -7pt to avoid company line overlapping with bullets
\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item
    \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & #2 \\
      \textit{\small#3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-5pt}
}

\newcommand{\resumeProjectHeading}[3]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \small#1 & #2 \\
      \textit{\small #3} \\
    \end{tabular*}\vspace{-5pt}
}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.15in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}[leftmargin=0.15in, label=$\bullet$, topsep=0pt, parsep=0pt, itemsep=-2pt]}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-5pt}}

% ─── DOCUMENT ────────────────────────────────────

\begin{document}

% ─── HEADER (compact) ────────────────────────────
\begin{center}
    {\fontsize{18}{18}\selectfont \textbf{\scshape (( personal.name | latex ))}} \\ \vspace{2pt}
    \small
    (( personal.phone | latex )) $|$
    \href{mailto:(( personal.email ))}{\underline{(( personal.email | latex ))}} $|$
    \href{https://(( personal.website ))}{\underline{(( personal.website | latex ))}} $|$
    \href{https://(( personal.linkedin ))}{\underline{(( personal.linkedin | latex ))}} $|$
    \href{https://(( personal.github ))}{\underline{(( personal.github | latex ))}}
\end{center}
\vspace{-8pt}

% ─── EDUCATION ───────────────────────────────────
\section{Education}
  \resumeSubHeadingListStart
  (% for edu in education %)
    \resumeSubheading
      {(( edu.institution | latex ))}{(( edu.start_date )) -- (( edu.end_date ))}
      {(( edu.degree | latex ))(% if edu.minor %); Minor in (( edu.minor | latex ))(% endif %)}{(( edu.location | latex ))}
      (% if edu.gpa %)
      {\small\hspace{0.15in}\textit{GPA: (( edu.gpa )) $|$ (( edu.honors | latex ))}}
      \vspace{-5pt}
      (% endif %)
  (% endfor %)
  \resumeSubHeadingListEnd
  \vspace{-6pt}

% ─── TECHNICAL SKILLS ────────────────────────────
\section{Technical Skills}
 \begin{itemize}[leftmargin=0.15in, label={}, itemsep=-3pt]
    \small{\item{
    (% for cat in skill_categories %)
     \textbf{(( cat['label'] ))}{: (( cat['items'] | join(', ') | latex ))} \\
    (% endfor %)
    }}
 \end{itemize}
 \vspace{-8pt}

% ─── EXPERIENCE ──────────────────────────────────
(% if jobs %)
\section{Experience}
  \resumeSubHeadingListStart
  (% for job in jobs %)
    \resumeSubheading
      {(( job.title | latex ))}{(( job.start_date )) -- (( job.end_date ))}
      {(( job.company | latex ))}{(( job.location | latex ))}
    \resumeItemListStart
    (% for bullet in job.selected_bullets %)
      \resumeItem{(( bullet.text | latex ))}
    (% endfor %)
    \resumeItemListEnd
  (% endfor %)
  \resumeSubHeadingListEnd
(% endif %)

% ─── PROJECTS ────────────────────────────────────
(% if projects %)
\section{Personal Projects}
  \resumeSubHeadingListStart
  (% for proj in projects %)
    (% set link_parts = [] %)
    (% if proj.links %)
      (% if proj.links.get('repo') %)
        (% set _ = link_parts.append('\\href{' ~ proj.links.repo ~ '}{\\underline{GitHub}}') %)
      (% endif %)
      (% if proj.links.get('web_repo') %)
        (% set _ = link_parts.append('\\href{' ~ proj.links.web_repo ~ '}{\\underline{GitHub}}') %)
      (% endif %)
      (% if proj.links.get('live') %)
        (% set _ = link_parts.append('\\href{' ~ proj.links.live ~ '}{\\underline{Live}}') %)
      (% endif %)
      (% if proj.links.get('app_store') %)
        (% set _ = link_parts.append('\\href{' ~ proj.links.app_store ~ '}{\\underline{App Store}}') %)
      (% endif %)
      (% if proj.links.get('demo') %)
        (% set _ = link_parts.append('\\href{' ~ proj.links.demo ~ '}{\\underline{Demo}}') %)
      (% endif %)
    (% endif %)
    (% set link_str = ' $|$ '.join(link_parts) if link_parts else '' %)
    (% set title_str = '\\textbf{' ~ (proj.title | latex) ~ '}' ~ (' $|$ ' ~ link_str if link_str else '') %)
    \resumeProjectHeading
      {(( title_str ))}
      {(( proj.start_date )) -- (( proj.end_date ))}
      {(( proj.tagline | latex ))}
    \resumeItemListStart
    (% for bullet in proj.selected_bullets %)
      \resumeItem{(( bullet.text | latex ))}
    (% endfor %)
    \resumeItemListEnd
  (% endfor %)
  \resumeSubHeadingListEnd
(% endif %)

\end{document}
